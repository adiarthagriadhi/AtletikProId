# Salin file ini jadi .env sebelum menjalankan server ("cp .env.example .env"),
# lalu isi JWT_SECRET dengan string acak (wajib — server menolak jalan tanpa
# ini). Variabel lain opsional, isi sesuai kebutuhan deploy.

# Wajib — string acak panjang, dipakai menandatangani sesi login. Jangan
# pakai nilai contoh di bawah ini di server sungguhan.
JWT_SECRET=ganti-dengan-string-acak-panjang-dan-rahasia

# Opsional — secret terpisah untuk sesi portal atlet. Kalau kosong,
# server memakai JWT_SECRET + ":athlete" (berbeda dari sesi pelatih).
JWT_ATHLETE_SECRET=

# Opsional — port server (default 3000 jika kosong). Di banyak layanan
# hosting Node (termasuk Hostinger), port sudah ditentukan platform lewat
# environment variable ini — biasanya tidak perlu diisi manual.
PORT=3000

# Opsional — kunci one-time untuk endpoint POST /api/auth/admin-setup
# (bikin akun admin pertama lewat API tanpa akses shell/server). Set nilai
# acak di sini, panggil endpoint sekali dengan kunci yang sama, lalu boleh
# dihapus lagi dari .env — endpoint otomatis terkunci begitu admin pertama
# dibuat. Kalau punya akses shell ke server, alternatifnya jalankan
# "npm run create-admin" saja, tidak perlu variabel ini.
ADMIN_SETUP_KEY=

# Opsional — dipakai membentuk link publik (mis. di notifikasi/invite atlet).
APP_PUBLIC_URL=https://atletikpro.id

# Reset password: jika SMTP terkirim, tautan tidak tampil di API.
# Set false hanya jika SMTP belum jalan dan butuh tautan di layar.
HIDE_RESET_LINK=

# SMTP Hostinger — isi SMTP_PASS di .env server (jangan masukkan ke git).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@atletikpro.id
SMTP_PASS=
SMTP_FROM=Atletik Pro Id <admin@atletikpro.id>

# Opsional — kredensial Midtrans (payment gateway). Tanpa ini, endpoint
# pembayaran nonaktif ("Pembayaran belum dikonfigurasi") tapi seluruh fitur
# lain tetap berjalan normal.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Penyimpanan data:
#   mysql  = panel Database Hostinger (disarankan jika sudah buat DB)
#   sqlite = file data/app.sqlite (Node 22+)
#   json   = data/db.json
# Jika MYSQL_DATABASE + USER + PASSWORD terisi, default-nya mysql.
DB_BACKEND=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=nama_database
MYSQL_USER=nama_user_database
MYSQL_PASSWORD=

# ---------- Akun atlet mandiri & selling page ----------
# Lama coba gratis Premium (hari) setelah atlet mandiri membuat profil.
# 0 = tanpa masa coba (langsung paket gratis).
ATHLETE_TRIAL_DAYS=7
# Harga Premium atlet (IDR). Terpisah dari harga paket pelatih.
ATHLETE_MONTHLY_PRICE_IDR=29000
ATHLETE_ANNUAL_PRICE_IDR=199000

# ---------- Coach AI (opsional) ----------
# Tanpa ANTHROPIC_API_KEY semua fitur Coach AI tetap jalan memakai teks
# berbasis aturan. Dapatkan key di console.anthropic.com. JANGAN commit key.
ANTHROPIC_API_KEY=
# Model (default claude-opus-5). Untuk biaya ~5x lebih murah: claude-haiku-4-5
AI_MODEL=
# low | medium | high — "low" paling hemat token (default low)
AI_EFFORT=low
# Batas total panggilan AI per hari per server (pengaman biaya)
AI_DAILY_LIMIT=500
# Kuota "Tanya Coach" per atlet per hari
AI_ASK_PREMIUM_PER_DAY=5
AI_ASK_FREE_PER_DAY=1
# Set false untuk mematikan panggilan AI tanpa menghapus key
AI_ENABLED=
